# ==========================================
# BACKEND: ASP.NET Core (PECB-BE)
# ==========================================
**/bin/
**/obj/
PECB-BE/Properties/publishProfiles/
**/msvsmon.sqlite
**/*.user
**/*.userosscache
**/*.sln.docstates

# Local connection strings and secrets.
# A working default ships in the committed appsettings.json, so a fresh clone runs
# without these files; add one only to point at a different SQL Server instance.
PECB-BE/appsettings.Development.json
PECB-BE/appsettings.Local.json
**/secrets.json

# User-specific files
.vs/
.vscode/
.idea/

# ==========================================
# BACKEND TESTS: xUnit (PECB-BE/Tests)
# ==========================================
TestResults/
*.trx
*.coverage

# ==========================================
# FRONTEND: Angular (PECB-FE)
# ==========================================
# Dependencies and builds
PECB-FE/node_modules/
PECB-FE/.angular/
PECB-FE/dist/

# Local environment overrides
PECB-FE/src/environments/environment.development.ts
PECB-FE/src/environments/environment.local.ts

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS specific files
.DS_Store
Thumbs.db
